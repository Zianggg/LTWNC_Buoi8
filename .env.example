# Sao chép thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# Sinh bằng: npx auth secret   (hoặc: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=

# Cần khi chạy `next start` trên localhost (không phải Vercel)
AUTH_TRUST_HOST=true

# GitHub OAuth app (Settings → Developer settings → OAuth Apps)
#   Homepage URL:  http://localhost:3000
#   Callback URL:  http://localhost:3000/api/auth/callback/github
# Để trống thì nút GitHub bị vô hiệu hoá, đăng nhập email/mật khẩu vẫn chạy.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Login GitHub (phân tách bằng dấu phẩy) được cấp vai trò admin; còn lại là user
ADMIN_GITHUB_LOGINS=

# URL gốc dùng cho metadataBase, canonical, sitemap, JSON-LD
SITE_URL=http://localhost:3000
